{
   "uid": "gg-gate",
   "title": "Buttoners service gate",
   "tags": [
      "buttoners"
   ],
   "timezone": "Asia/Krasnoyarsk",
   "editable": true,
   "graphTooltip": 1,
   "time": {
      "from": "now-4h",
      "to": "now"
   },
   "fiscalYearStartMonth": 0,
   "weekStart": "monday",
   "refresh": "1m",
   "schemaVersion": 42,
   "panels": [
      {
         "type": "timeseries",
         "targets": [
            {
               "expr": "sum(rate(buttoners_grpc_server_handle_seconds_count{service=~\"$service\", pod=~\"$pod\"}[$__rate_interval])) by (server_addr)",
               "legendFormat": "grpc server =\u003e {{server_addr}}"
            },
            {
               "expr": "sum(rate(buttoners_http_server_handle_seconds_count{service=~\"$service\", pod=~\"$pod\"}[$__rate_interval])) by (server_addr)",
               "legendFormat": "http server =\u003e {{server_addr}}"
            }
         ],
         "title": "Входящий RPS",
         "transparent": false,
         "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
         },
         "gridPos": {
            "h": 9,
            "w": 6,
            "x": 0,
            "y": 0
         },
         "repeatDirection": "h",
         "options": {
            "legend": {
               "displayMode": "table",
               "placement": "bottom",
               "showLegend": true,
               "sortBy": "Mean",
               "sortDesc": true,
               "calcs": [
                  "mean",
                  "lastNotNull"
               ]
            },
            "tooltip": {
               "mode": "",
               "sort": ""
            }
         },
         "fieldConfig": {
            "defaults": {
               "unit": "reqps",
               "custom": {}
            },
            "overrides": []
         }
      },
      {
         "type": "timeseries",
