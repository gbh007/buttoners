   "templating": {
      "list": [
         {
            "type": "datasource",
            "name": "metrics",
            "skipUrlSync": false,
            "query": "prometheus",
            "multi": false,
            "allowCustomValue": true,
            "includeAll": false,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "query",
            "name": "service",
            "skipUrlSync": false,
            "query": "label_values(process_cpu_seconds_total{service=~\"gate\"}, service)",
            "datasource": {
               "type": "prometheus",
               "uid": "${metrics}"
            },
            "multi": true,
            "allowCustomValue": true,
            "refresh": 2,
            "includeAll": true,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "query",
            "name": "pod",
            "skipUrlSync": false,
            "query": "label_values(process_cpu_seconds_total{service=~\"$service\"}, pod)",
            "datasource": {
               "type": "prometheus",
               "uid": "${metrics}"
            },
            "multi": true,
            "allowCustomValue": true,
            "refresh": 2,
            "includeAll": true,
            "allValue": ".+",
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "custom",
            "name": "quantile",
            "skipUrlSync": false,
            "query": ".50,.80,.95,.99",
            "current": {
               "selected": true,
               "text": ".80",
               "value": ".80"
            },
            "multi": false,
            "allowCustomValue": true,
            "includeAll": false,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         }
      ]
