{
   "uid": "gg-notification",
   "title": "Buttoners service notification",
   "tags": [
      "buttoners"
   ],
   "timezone": "Asia/Krasnoyarsk",
   "editable": true,
   "graphTooltip": 1,
   "time": {
      "from": "now-4h",
      "to": "now"
   },
   "fiscalYearStartMonth": 0,
   "weekStart": "monday",
   "refresh": "1m",
   "schemaVersion": 42,
   "panels": [
      {
         "type": "timeseries",
         "targets": [
            {
               "expr": "sum(rate(buttoners_http_server_handle_seconds_count{service=~\"$service\", pod=~\"$pod\"}[$__rate_interval])) by (server_addr)",
               "legendFormat": "http server =\u003e {{server_addr}}"
            }
         ],
         "title": "Входящий RPS",
         "transparent": false,
         "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
         },
         "gridPos": {
            "h": 9,
            "w": 6,
            "x": 0,
            "y": 0
         },
         "repeatDirection": "h",
         "options": {
            "legend": {
               "displayMode": "table",
               "placement": "bottom",
               "showLegend": true,
               "sortBy": "Mean",
               "sortDesc": true,
               "calcs": [
                  "mean",
                  "lastNotNull"
               ]
            },
            "tooltip": {
               "mode": "",
               "sort": ""
            }
         },
         "fieldConfig": {
            "defaults": {
               "unit": "reqps",
               "custom": {}
            },
            "overrides": []
         }
      },
      {
         "type": "timeseries",
         "targets": [
            {
               "expr": "histogram_quantile($quantile, sum(rate(buttoners_http_server_handle_seconds_bucket{service=~\"$service\", pod=~\"$pod\"}[$__rate_interval])) by (server_addr, le))",
               "legendFormat": "http server =\u003e {{server_addr}}"
            }
         ],
         "title": "Входящие задержки $quantile",
         "transparent": false,
         "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
         },
         "gridPos": {
            "h": 9,
            "w": 6,
            "x": 6,
            "y": 0
         },
         "repeatDirection": "h",
         "options": {
            "legend": {
               "displayMode": "table",
               "placement": "bottom",
               "showLegend": true,
               "sortBy": "Mean",
               "sortDesc": true,
               "calcs": [
                  "mean",
                  "lastNotNull"
               ]
            },
            "tooltip": {
               "mode": "",
               "sort": ""
            }
         },
         "fieldConfig": {
            "defaults": {
               "unit": "reqps",
               "custom": {}
            },
            "overrides": []
         }
      },
      {
         "type": "timeseries",
         "targets": [
            {
               "expr": "sum(rate(buttoners_http_server_handle_seconds_count{service=~\"$service\", pod=~\"$pod\", status=~\"4\\\\d{2}\"}[$__rate_interval])) by (server_addr) or vector(0)/ sum(rate(buttoners_http_server_handle_seconds_count{service=~\"$service\", pod=~\"$pod\"}[$__rate_interval])) by (server_addr)",
               "legendFormat": "http server 4xx =\u003e {{server_addr}}"
            },
            {
               "expr": "sum(rate(buttoners_http_server_handle_seconds_count{service=~\"$service\", pod=~\"$pod\", status=~\"5\\\\d{2}\"}[$__rate_interval])) by (server_addr) or vector(0)/ sum(rate(buttoners_http_server_handle_seconds_count{service=~\"$service\", pod=~\"$pod\"}[$__rate_interval])) by (server_addr)",
               "legendFormat": "http server 5xx =\u003e {{server_addr}}"
            }
         ],
         "title": "Входящий error rate",
         "transparent": false,
         "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
         },
         "gridPos": {
            "h": 9,
            "w": 6,
            "x": 12,
            "y": 0
         },
         "repeatDirection": "h",
         "options": {
            "legend": {
               "displayMode": "table",
               "placement": "bottom",
               "showLegend": true,
               "sortBy": "Mean",
               "sortDesc": true,
               "calcs": [
                  "mean",
                  "lastNotNull"
               ]
            },
            "tooltip": {
               "mode": "",
               "sort": ""
            }
         },
         "fieldConfig": {
            "defaults": {
               "unit": "percentunit",
               "custom": {}
            },
            "overrides": []
         }
      },
      {
         "type": "logs",
         "targets": [
            {
               "expr": "service: ($service) pod: ($pod)"
            }
         ],
         "title": "Logs",
         "transparent": false,
         "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${logs}"
         },
         "gridPos": {
            "h": 12,
            "w": 24,
            "x": 18,
            "y": 0
         },
         "repeatDirection": "h",
         "options": {
            "showLabels": false,
            "showCommonLabels": false,
            "showTime": false,
            "showLogContextToggle": false,
            "wrapLogMessage": false,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "sortOrder": "Descending",
            "dedupStrategy": ""
         }
      },
      {
         "type": "table",
         "targets": [
            {
               "queryType": "traceql",
               "query": "{resource.service.name=$service}",
               "filters": []
            }
         ],
         "title": "Traces",
         "transparent": false,
         "datasource": {
            "type": "tempo",
            "uid": "${traces}"
         },
         "gridPos": {
            "h": 12,
            "w": 24,
            "x": 0,
            "y": 12
         },
         "repeatDirection": "h",
         "options": {
            "frameIndex": 0,
            "showHeader": true,
            "showTypeIcons": false,
            "footer": {
               "show": false,
               "reducer": null,
               "countRows": false
            },
            "cellHeight": "sm"
         },
         "fieldConfig": {
            "defaults": {
               "custom": {
                  "align": "auto",
                  "inspect": false
               }
            },
            "overrides": []
         }
      }
   ],
   "templating": {
      "list": [
         {
            "type": "datasource",
            "name": "metrics",
            "hide": 2,
            "skipUrlSync": false,
            "query": "prometheus",
            "multi": false,
            "allowCustomValue": true,
            "includeAll": false,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "datasource",
            "name": "logs",
            "hide": 2,
            "skipUrlSync": false,
            "query": "victoriametrics-logs-datasource",
            "multi": false,
            "allowCustomValue": true,
            "includeAll": false,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "datasource",
            "name": "traces",
            "hide": 2,
            "skipUrlSync": false,
            "query": "tempo",
            "multi": false,
            "allowCustomValue": true,
            "includeAll": false,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "query",
            "name": "service",
            "skipUrlSync": false,
            "query": "label_values(process_cpu_seconds_total{service=~\"notification\"}, service)",
            "datasource": {
               "type": "prometheus",
               "uid": "${metrics}"
            },
            "multi": true,
            "allowCustomValue": true,
            "refresh": 2,
            "includeAll": true,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "query",
            "name": "pod",
            "skipUrlSync": false,
            "query": "label_values(process_cpu_seconds_total{service=~\"$service\"}, pod)",
            "datasource": {
               "type": "prometheus",
               "uid": "${metrics}"
            },
            "multi": true,
            "allowCustomValue": true,
            "refresh": 2,
            "includeAll": true,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         },
         {
            "type": "custom",
            "name": "quantile",
            "skipUrlSync": false,
            "query": ".50,.80,.95,.99",
            "current": {
               "selected": true,
               "text": ".80",
               "value": ".80"
            },
            "multi": false,
            "allowCustomValue": true,
            "includeAll": false,
            "auto": false,
            "auto_min": "10s",
            "auto_count": 30
         }
      ]
   },
   "annotations": {},
   "links": [
      {
         "title": "Buttoners boards",
         "type": "dashboards",
         "icon": "",
         "tooltip": "",
         "tags": [
            "buttoners"
         ],
         "asDropdown": true,
         "placement": "inControlsMenu",
         "targetBlank": false,
         "includeVars": false,
         "keepTime": true
      },
      {
         "title": "Github",
         "type": "link",
         "icon": "",
         "tooltip": "",
         "url": "https://github.com/gbh007/buttoners",
         "tags": [],
         "asDropdown": false,
         "placement": "inControlsMenu",
         "targetBlank": true,
         "includeVars": false,
         "keepTime": false
      }
   ]
}
