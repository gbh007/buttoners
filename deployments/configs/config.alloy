logging {
	level  = "error"
	format = "json"
}

// CONTAINER LOGS

discovery.docker "container_logs" {
	host = "unix:///var/run/docker.sock"
}

loki.source.docker "container_logs" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.container_logs.targets
	relabel_rules = loki.relabel.container_logs.rules
	forward_to    = [loki.process.container_logs.receiver]
	labels        = {
		job = "dockerlogs",
	}
}

loki.relabel "container_logs" {
	forward_to = []

	rule {
		action      = "labelmap"
		regex       = "__meta_docker_container_id"
		replacement = "container_id"
	}

	rule {
		action      = "labelmap"
		regex       = "__meta_docker_container_label_com_docker_compose_service"
		replacement = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "pod"
		replacement   = "$1"
	}

	rule {
		action        = "keep"
		source_labels = ["__meta_docker_container_label_alloy_logs_scrape"]
		regex         = "true"
	}

	rule {
		action        = "keep"
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "buttoners"
	}
}

loki.process "container_logs" {
	stage.drop {
		source              = "container_id"
		expression          = "^$"
		drop_counter_reason = "missing_required_docker_label"
	}

	stage.regex {
		expression         = "level=(?P<level>\\S+)"
		labels_from_groups = true
	}

	stage.regex {
		expression         = "\"level\"\\s*:\\s*\"(?P<level>[^\"]+)\""
		labels_from_groups = true
	}

	stage.regex {
		expression         = "trace_id=(?P<trace_id>\\S+)"
		labels_from_groups = true
	}

	stage.regex {
		expression         = "\"trace_id\"\\s*:\\s*\"(?P<trace_id>[^\"]+)\""
		labels_from_groups = true
	}

	stage.template {
		source   = "level"
		template = "{{ ToUpper .Value }}"
	}

	stage.labels {
		values = {
			level = "level",
		}
	}

	forward_to = [loki.write.default.receiver]
}

// CONTAINER METRICS

discovery.docker "container_metrics" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "label"
		values = ["prometheus.io/scrape=true"]
	}
}

discovery.relabel "container_metrics" {
	targets = discovery.docker.container_metrics.targets

	rule {
		source_labels = ["__meta_docker_container_label_prometheus_io_scrape"]
		regex         = "true"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "buttoners"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.+)"
		action        = "replace"
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_prometheus_io_path"]
		regex         = "(.+)"
		action        = "replace"
		target_label  = "__metrics_path__"
	}

	rule {
		source_labels = ["__address__", "__meta_docker_container_label_prometheus_io_port"]
		regex         = "([^:]+)(?::\\d+)?;(\\d+)"
		replacement   = "${1}:${2}"
		target_label  = "__address__"
	}
}

prometheus.scrape "container_metrics" {
	targets         = discovery.relabel.container_metrics.output
	forward_to      = [prometheus.remote_write.default.receiver]
	scrape_interval = "5s"
	scrape_timeout  = "1s"
}

// CONTAINER TRACES

otelcol.receiver.otlp "container_traces" {
	http { }

	output {
		traces = [otelcol.exporter.otlphttp.traces.input]
	}
}

// WRITERS

loki.write "default" {
	endpoint {
		url = "http://victorialogs:9428/insert/loki/api/v1/push?disable_message_parsing=1"
	}
	external_labels = {
		host     = constants.hostname,
		scrapper = "alloy",
	}
}

prometheus.remote_write "default" {
	endpoint {
		url = "http://victoriametrics:8428/prometheus/api/v1/write"
	}
}

otelcol.exporter.otlphttp "traces" {
	client {
		endpoint = "http://victoriatraces:10428/insert/opentelemetry"
	}
}
